@using SignalRWebUI.Dtos.ProductDtos
@model UpdateProductDto

@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Ürün İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Ürün Güncelleme işlemi</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <input type="hidden" asp-for="ProductId">

                                <label for="productname">Ürün Adı</label>
                                <input asp-for="ProductName" type="text" class="form-control">
                            </div>
                            <div class="form-group">
                                <label for="description">Açıklaması</label>
                                <input asp-for="Description" type="text" class="form-control">
                            </div>
                            <div class="form-group">
                                <label for="price">Fiyatı</label>
                                <input asp-for="Price" type="text" class="form-control">
                            </div>
                            <div class="form-group">
                                <label for="imageurl">Görseli</label>
                                <input asp-for="ImageUrl" type="text" class="form-control">
                            </div>
                            <div class="form-group">
                                <label for="categoryname">Ürün Kategorisini Seçiniz</label>
                                <select asp-for="CategoryId" asp-items="ViewBag.v" class="form-control">
                                    <option value="">---Kategori Seçiniz----</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Ürünü Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>