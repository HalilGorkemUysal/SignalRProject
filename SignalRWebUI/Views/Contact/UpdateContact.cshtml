@model UpdateContactDto

@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Ana Sayfa İletişim İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Yeni İletişim Girişi</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <input  type="hidden" asp-for="ContactId"/>

                                <label for="title">Konumu Giriniz</label>
                                <input asp-for="Location" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="imageurl">Numarayı Giriniz</label>
                                <input asp-for="Number" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="description">Maili Giriniz</label>
                                <input asp-for="Mail" type="email" class="form-control" />
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="imageurl">İletişim Açıklaması Giriniz</label>
                                <input asp-for="FooterDescription" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">İletişimi Ekle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>