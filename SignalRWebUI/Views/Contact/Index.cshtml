@using SignalRWebUI.Dtos.ContactDtos
@model List<ResultContactDto>

@{
	Layout = "~/Views/AdminLayout/Index.cshtml";
	int counter = 0;
}
<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Ana Sayfa İletişim İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">İletişim</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							İletişim ile ilgili bilgileri aşağıda görebilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Konum</th>
									<th scope="col">Mail</th>
									<th scope="col">Numara</th>
									<th scope="col">Açıklama</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									counter++;
									<tr>
										<td>@counter</td>
										<td>@item.Location</td>
										<td>@item.Mail</td>
										<td>@item.Number</td>
										<td>@item.FooterDescription</td>
										<td><a href="/Contact/DeleteContact/@item.ContactId/" class="btn btn-outline-danger">Sil</a></td>
										<td><a href="/Contact/UpdateContact/@item.ContactId/" class="btn btn-outline-success">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Contact/CreateContact/" class="btn btn-outline-primary">Yeni İletişim Girişi</a>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>