@model UpdateFeatureDto

@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Öne Çıkan İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Öne Çıkan AlanGüncelleme İşlemi Yazı Girişi</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <input type="hidden" asp-for="FeatureId"/>

                                <label for="title1">1.Başlığı Giriniz</label>
                                <input asp-for="Title1" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="title">1.Açıklamayı Giriniz</label>
                                <input asp-for="Description1" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="title2">2.Başlığı Giriniz</label>
                                <input asp-for="Title2" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="title">2.Açıklamayı Giriniz</label>
                                <input asp-for="Description2" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="title3">3.Başlığı Giriniz</label>
                                <input asp-for="Title3" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="title">3.Açıklamayı Giriniz</label>
                                <input asp-for="Description3" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Öne Çıkan Alanı Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>