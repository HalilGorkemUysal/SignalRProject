@model List<ResultMenuTableDto>

@{
    Layout = null;
    string color = "";
    string status = "";
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("UILayoutHead")

<style>
    .widgetfalse {
        width: 200px;
        height: 100px;
        background-color: #2ecc71; /* Yeşil arka plan */
        display: flex;
        align-items: center;
        border-radius: 10px;
        color: white;
        font-family: Arial, sans-serif;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .widgettrue {
        width: 200px;
        height: 100px;
        background-color: palevioletred; /* Kırmızı arka plan */
        display: flex;
        align-items: center;
        border-radius: 10px;
        color: white;
        font-family: Arial, sans-serif;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .widget-icon {
        width: 40px;
        height: 40px;
        background-color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-left: 10px;
    }

        .widget-icon i {
            font-size: 24px;
            color: #2ecc71;
        }

    .widget-text {
        margin-left: 20px;
    }

        .widget-text h3 {
            margin: 0;
            font-size: 18px;
        }

        .widget-text p {
            margin: 0;
            font-size: 14px;
        }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<body class="sub_page">

    <div class="hero_area">
        <div class="bg-box">
            <img src="~/feane-v1.0.0/images/hero-bg.jpg" alt="">
        </div>
        @await Component.InvokeAsync("UILayoutNavbar")

    </div>
    <br />
    <br />
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-dark mb-30">
                    <a class="breadcrumb-item text-white" href="/Default/Index/">Ana Sayfa</a>
                    <a class="breadcrumb-item text-white" href="/Menu/Index/">Masa Listesi</a>
                    <span class="breadcrumb-item active">Masa Seçimi Yapınız</span>
                </nav>
            </div>
        </div>
    </div>

    <div class="container-fluid">

        <div class="row px-xl-5" style="margin-right:10px;">
            @foreach (var item in Model)
            {
                @if (item.Status == true)
                {
                    color = "widgettrue";
                    status = "Masa Dolu";
                }
                else
                {
                    color = "widgetfalse";
                    status = "Masa Boş";
                }
                <div class="col-md-3 mb-4">
                    <div class="@color">
                        <div class="widget-icon">
                            <a href="/Default/Index/"><i class="fas fa-chair"></i></a>
                        </div>
                        <div class="widget-text">
                            <h3>@item.Name</h3>
                            <p>@status</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    

    @await Component.InvokeAsync("UILayoutFooter")
    @await Component.InvokeAsync("UILayoutScripts")

    <script>
        function showproductid(value) {
            var id = value;
            $.ajax({
                type: 'post',
                data: { item: id },
                contentType: 'json',
                success: function() {
                    swal("Seçilen ürün ID: " + id, "Seçiminizi yaptınız!", "success")
                }
            });
        }
    </script>

</body>

</html>
