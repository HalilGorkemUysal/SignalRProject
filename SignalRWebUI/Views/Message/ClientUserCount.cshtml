@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("UILayoutHead")

<body class="sub_page">

    <div class="hero_area">
        <div class="bg-box">
            <img src="~/feane-v1.0.0/images/hero-bg.jpg" alt="">
        </div>
        @await Component.InvokeAsync("UILayoutNavbar")

    </div>

    <section class="food_section layout_padding">
        <div class="container">
            <script type="text/javascript">

                $(document).ready(() => {

                    var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7067/SignalRHub").build();
                    $("#connstatus").text(connection.state);
                    connection.start().then(() => {
                        $("#connstatus").text(connection.state);
                    }).catch((err) => { console.log(err) });

                    connection.on("ReceiveClientCount", (clientCount) => {
                        $("#clientCountValue").text(clientCount);
                    });

                });
            </script>

            <h4 class="page-title">Anlık Client Sayfası:<strong id="clientCountValue"></strong></h4>

        </div>
    </section>

    @await Component.InvokeAsync("UILayoutFooter")
    @await Component.InvokeAsync("UILayoutScripts")

</body>

</html>
